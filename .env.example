SLACK_BOT_TOKEN=xoxb-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# === MONITORING & ANALYTICS ===
# Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_grafana_admin_password

# Prometheus
PROMETHEUS_RETENTION_DAYS=30

# Sentry (error tracking)
SENTRY_DSN=https://XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX@o000000.ingest.sentry.io/0000000

# DataDog (optional)
DATADOG_API_KEY=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
DATADOG_APP_KEY=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# === MYCELIUM EI SPECIFIC ===
# ElevenLabs (for voice features)
ELEVENLABS_API_KEY=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Weather Service
WEATHER_API_KEY=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# === CROWE QUANTUM NEXUS AI SPECIFIC ===
# Quantum Computing Configuration
QUANTUM_COMPUTE_ENABLED=true
QUANTUM_SIMULATOR=qiskit
QUANTUM_BACKEND=local
IBM_QUANTUM_TOKEN=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# GPU Configuration
GPU_ENABLED=false
CUDA_VISIBLE_DEVICES=0

# === CROWE SENSE SPECIFIC ===
# IoT Configuration
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
IOT_DEVICE_PREFIX=CS_

# Sensor Calibration
SENSOR_CALIBRATION_ENABLED=true
CALIBRATION_INTERVAL_HOURS=24

# === FEATURE FLAGS ===
ENABLE_QUANTUM_OPTIMIZATION=true
ENABLE_AI_PREDICTIONS=true
ENABLE_WEATHER_INTEGRATION=true
ENABLE_IOT_SENSORS=true
ENABLE_BLOCKCHAIN=false
ENABLE_VOICE_FEATURES=false
ENABLE_OFFLINE_MODE=false
ENABLE_DEMO_MODE=false

# === COMPLIANCE & SECURITY ===
# EPA Compliance
EPA_REPORTING_ENABLED=true
EPA_ORG_ID=
EPA_API_KEY=
AUDIT_RETENTION_DAYS=2555  # 7 years

# GDPR/Privacy
GDPR_COMPLIANCE=true
DATA_RETENTION_DAYS=365
ENABLE_ANALYTICS=true
ANALYTICS_ANONYMOUS=true

# Security Headers
ENABLE_HSTS=true
ENABLE_CSP=true
CSP_REPORT_URI=https://nexus.crowelogic.com/csp-report

# === NETWORKING ===
# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002
CORS_ALLOW_CREDENTIALS=true

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# === PERFORMANCE ===
# Worker Configuration
WORKER_PROCESSES=4
WORKER_THREADS=2
CONNECTION_POOL_SIZE=20

# Cache Configuration
CACHE_TYPE=redis
CACHE_DEFAULT_TIMEOUT=300
CACHE_TTL=3600

# === LOGGING ===
LOG_LEVEL=INFO
LOG_FORMAT=json
JSON_LOGS=true
LOG_FILE_PATH=/var/log/nexus/app.log
LOG_FILE_MAX_SIZE=100M
LOG_FILE_BACKUP_COUNT=10

# === BACKUP CONFIGURATION ===
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *  # 2 AM daily
BACKUP_RETENTION_DAYS=30
BACKUP_ENCRYPTION_ENABLED=true
BACKUP_ENCRYPTION_KEY=CHANGE_ME_backup_encryption_key

# === EMAIL CONFIGURATION ===
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=alerts@crowelogic.com
SMTP_PASSWORD=CHANGE_ME_smtp_password
SMTP_USE_TLS=true
EMAIL_FROM=CroweQuantumMyceliumNexus <alerts@crowelogic.com>
ALERT_EMAIL=admin@crowelogic.com

# === DEPLOYMENT ===
# Docker Registry
DOCKER_REGISTRY=ghcr.io
DOCKER_USERNAME=michaelcrowe11
DOCKER_PASSWORD=CHANGE_ME_github_token

# Kong API Gateway
KONG_ADMIN_PORT=8001
KONG_PROXY_PORT=8000
KONG_PROXY_SSL_PORT=8443
KONG_DB_PASSWORD=CHANGE_ME_kong_password

# === DEVELOPMENT ===
# Hot Reload
HOT_RELOAD=false
FLASK_ENV=production
FLASK_DEBUG=false
REACT_APP_ENV=production

# Testing
TEST_DATABASE_URL=postgresql://test_user:test_password@localhost:5432/test_db
TEST_REDIS_URL=redis://localhost:6379/15
PYTEST_COVERAGE_THRESHOLD=80

# === PORTS CONFIGURATION ===
# Application Ports
MYCELIUM_PORT=8100
QUANTUM_PORT=9000
INTEGRATION_PORT=8080
WEATHER_PORT=8200
FRONTEND_PORT=3000

# Database Ports
POSTGRES_PORT=5432
REDIS_PORT=6379
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# Monitoring Ports
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
JAEGER_PORT=16686

# === CUSTOM CONFIGURATION ===
# Add any custom configuration here
CUSTOM_PARAM_1=
CUSTOM_PARAM_2=
CUSTOM_PARAM_3=
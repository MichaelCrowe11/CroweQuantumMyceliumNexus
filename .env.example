# ========================================
# CROWE QUANTUM MYCELIUM NEXUS - ENVIRONMENT CONFIGURATION
# ========================================
# Copy this file to .env and fill in your actual values

# === CORE CONFIGURATION ===
ENVIRONMENT=development
DOMAIN=localhost
PROJECT_NAME=CroweQuantumMyceliumNexus
DEBUG=false

# === DATABASE CONFIGURATION ===
# PostgreSQL Main Database
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=nexus_main
POSTGRES_USER=nexus_admin
POSTGRES_PASSWORD=CHANGE_ME_strong_password_here

# Unified Database Configuration
UNIFIED_DB_USER=nexus_admin
UNIFIED_DB_PASSWORD=CHANGE_ME_unified_db_password
DATABASE_URL=postgresql://nexus_admin:CHANGE_ME_unified_db_password@unified-db:5432/nexus_main

# Audit Database
AUDIT_DB_PASSWORD=CHANGE_ME_audit_password
AUDIT_DATABASE_URL=postgresql://audit_user:CHANGE_ME_audit_password@audit:5432/audit_db

# === CACHE & MESSAGE QUEUE ===
# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_redis_password
REDIS_URL=redis://:CHANGE_ME_redis_password@unified-cache:6379/0

# RabbitMQ Configuration
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=nexus_mq
RABBITMQ_PASSWORD=CHANGE_ME_rabbitmq_password
RABBITMQ_URL=amqp://nexus_mq:CHANGE_ME_rabbitmq_password@rabbitmq:5672/

# === SECURITY KEYS ===
SECRET_KEY=CHANGE_ME_generate_64_char_secret_key
JWT_SECRET_KEY=CHANGE_ME_generate_48_char_jwt_secret
ENCRYPTION_KEY=CHANGE_ME_generate_32_char_encryption_key
SECURITY_PASSWORD_SALT=CHANGE_ME_generate_32_char_salt


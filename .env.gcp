# ========================================
# GOOGLE CLOUD PLATFORM CONFIGURATION
# ========================================
# GCP project settings for CroweQuantumMyceliumNexus

# Project Configuration
GCP_PROJECT_ID=tenacious-cocoa-471700-i9
GCP_REGION=us-central1
GCP_ZONE=us-central1-a

# Service Endpoints
GCP_ARTIFACT_REGISTRY=us-central1-docker.pkg.dev
GCP_CONTAINER_REGISTRY=gcr.io/${GCP_PROJECT_ID}

# Kubernetes/GKE Configuration
GKE_CLUSTER_NAME=nexus-cluster
GKE_NAMESPACE=crowe-nexus

# Cloud SQL Configuration
CLOUD_SQL_INSTANCE=nexus-postgres
CLOUD_SQL_CONNECTION_NAME=${GCP_PROJECT_ID}:${GCP_REGION}:${CLOUD_SQL_INSTANCE}

# Cloud Storage Buckets
GCS_BACKUP_BUCKET=${GCP_PROJECT_ID}-backups
GCS_DATA_BUCKET=${GCP_PROJECT_ID}-data
GCS_MODELS_BUCKET=${GCP_PROJECT_ID}-models

# Cloud Run Configuration
CLOUD_RUN_SERVICE_NAME=crowe-nexus-api
CLOUD_RUN_REGION=${GCP_REGION}

# Firestore/Datastore
FIRESTORE_DATABASE=(default)

# BigQuery Configuration
BIGQUERY_DATASET=nexus_analytics
BIGQUERY_LOCATION=US

# Cloud Build
CLOUD_BUILD_TRIGGER=nexus-deploy

# Monitoring
STACKDRIVER_ENABLED=true

# Service Account
SERVICE_ACCOUNT_EMAIL=nexus-service@${GCP_PROJECT_ID}.iam.gserviceaccount.com
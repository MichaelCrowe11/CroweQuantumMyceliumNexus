# ========================================
# CROWE QUANTUM MYCELIUM NEXUS
# Unified Environment Configuration
# ========================================

# === Core Configuration ===
ENVIRONMENT=production
DOMAIN=nexus.crowelogic.com
PROJECT_NAME=CroweQuantumMyceliumNexus

# === Unified Database ===
UNIFIED_DB_USER=nexus_admin
UNIFIED_DB_PASSWORD=replace_with_secure_password_64chars
KONG_DB_PASSWORD=replace_with_secure_password_32chars

# === Redis Cache ===
REDIS_PASSWORD=replace_with_secure_password_32chars

# === RabbitMQ Message Queue ===
RABBITMQ_USER=nexus_mq
RABBITMQ_PASSWORD=replace_with_secure_password_32chars

# === Security Keys ===
SECRET_KEY=replace_with_secure_key_64chars
JWT_SECRET_KEY=replace_with_jwt_secret_48chars
ENCRYPTION_KEY=replace_with_encryption_key_32chars

# === MyceliumEI Configuration ===
MYCELIUM_DATABASE=mycelium
MYCELIUM_PORT=8100
OPENAI_API_KEY=
ELEVENLABS_API_KEY=
WEATHER_API_KEY=

# === CroweQuantumNexusAI Configuration ===
QUANTUM_DATABASE=quantum
QUANTUM_PORT=9000
QUANTUM_COMPUTE_ENABLED=true
GPU_ENABLED=false
QUANTUM_WORKERS=2

# === Integration Layer ===
INTEGRATION_PORT=8080
ORCHESTRATION_MODE=active
PIPELINE_BATCH_SIZE=1000

# === Monitoring ===
PROMETHEUS_ENABLED=true
GRAFANA_ADMIN_PASSWORD=replace_with_admin_password
JAEGER_ENABLED=true
LOG_LEVEL=INFO
JSON_LOGS=true

# === EPA Compliance ===
EPA_REPORTING_ENABLED=true
AUDIT_RETENTION_DAYS=2555
COMPLIANCE_REPORTS_DIR=/data/compliance
DATA_LINEAGE_TRACKING=true

# === Performance ===
MAX_WORKERS=4
CONNECTION_POOL_SIZE=20
CACHE_TTL=300
REQUEST_TIMEOUT=30

# === API Gateway (Kong) ===
KONG_ADMIN_PORT=8001
KONG_PROXY_PORT=8000
KONG_PROXY_SSL_PORT=8443

# === Backup Configuration ===
BACKUP_ENABLED=true
BACKUP_SCHEDULE="0 2 * * *"
BACKUP_RETENTION_DAYS=30
BACKUP_S3_BUCKET=nexus-backups
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# === Email/Notifications ===
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=alerts@crowelogic.com
SMTP_PASSWORD=
ALERT_EMAIL=admin@crowelogic.com
SLACK_WEBHOOK_URL=

# === Feature Flags ===
QUANTUM_OPTIMIZATION=true
AI_ENHANCED_PREDICTIONS=true
REAL_TIME_STREAMING=true
ADVANCED_ANALYTICS=true
MULTI_TENANT_MODE=false

# === External Services ===
GITHUB_TOKEN=
DOCKER_REGISTRY=ghcr.io
SENTRY_DSN=
DATADOG_API_KEY=
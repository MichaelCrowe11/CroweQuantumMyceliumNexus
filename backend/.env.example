# Google Cloud Configuration
GOOGLE_CLOUD_PROJECT=crowe-quantum-nexus
GOOGLE_APPLICATION_CREDENTIALS=./credentials/google-service-account.json
GOOGLE_MAPS_API_KEY=your_maps_api_key_here

# Google Services Configuration
GOOGLE_BIGQUERY_DATASET=environmental_data
GOOGLE_STORAGE_BUCKET=crowe-quantum-data
GOOGLE_IOT_REGISTRY=mycelium-sensors
GOOGLE_PUBSUB_TOPIC=sensor-data
GOOGLE_PUBSUB_SUBSCRIPTION=sensor-data-sub

# Server Configuration
PORT=8300
NODE_ENV=production

# Database Configuration
FIRESTORE_COLLECTION_MYCELIUM=mycelium_networks
FIRESTORE_COLLECTION_SENSORS=environmental_sensors
FIRESTORE_COLLECTION_QUANTUM=quantum_computations

# API Keys (obtain from Google Cloud Console)
# 1. Go to https://console.cloud.google.com
# 2. Create a new project or select existing
# 3. Enable required APIs:
#    - Maps JavaScript API
#    - Geocoding API
#    - Places API
#    - Vision API
#    - BigQuery API
#    - Cloud Storage API
#    - Cloud IoT API
#    - Cloud Firestore API
#    - Cloud Pub/Sub API
# 4. Create service account and download JSON key
# 5. Create API key for Maps services
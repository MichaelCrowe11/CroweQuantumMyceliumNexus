FROM rust:1.75-slim as builder

WORKDIR /app

# Install build dependencies
RUN apt-get update && apt-get install -y \
    pkg-config \
    libssl-dev \
    cmake \
    g++ \
    protobuf-compiler \
    && rm -rf /var/lib/apt/lists/*

# Copy workspace files
COPY Cargo.toml Cargo.lock ./
COPY src ./src
COPY build.rs ./

# Build the orchestrator binary
RUN cargo build --release --bin orchestrator --features quantum-acceleration

# Runtime stage
FROM debian:bookworm-slim

WORKDIR /app

# Install runtime dependencies
RUN apt-get update && apt-get install -y \
    libssl3 \
    ca-certificates \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy the binary from builder
COPY --from=builder /app/target/release/orchestrator /app/orchestrator

# Create necessary directories
RUN mkdir -p /app/config /app/data /app/logs

# Set environment variables
ENV RUST_LOG=info
ENV ORCHESTRATOR_PORT=8300
ENV ENABLE_METRICS=true

EXPOSE 8300

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8300/health || exit 1

# Run the orchestrator
CMD ["./orchestrator", "--port", "8300", "--config", "/app/config/orchestrator.toml"]
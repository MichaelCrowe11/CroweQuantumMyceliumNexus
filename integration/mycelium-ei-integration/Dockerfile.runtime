FROM rust:1.75-slim as builder

WORKDIR /app

# Install build dependencies
RUN apt-get update && apt-get install -y \
    pkg-config \
    libssl-dev \
    cmake \
    g++ \
    && rm -rf /var/lib/apt/lists/*

# Copy workspace files
COPY Cargo.toml Cargo.lock ./
COPY src ./src

# Build the application
RUN cargo build --release --features quantum-acceleration

# Runtime stage
FROM debian:bookworm-slim

WORKDIR /app

# Install runtime dependencies
RUN apt-get update && apt-get install -y \
    libssl3 \
    ca-certificates \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy the binary from builder
COPY --from=builder /app/target/release/mycelium-ei-integration /app/mycelium-runtime

# Create necessary directories
RUN mkdir -p /app/programs /app/data /app/logs

# Set environment variables
ENV RUST_LOG=info
ENV MYCELIUM_THREADS=4
ENV QUANTUM_BRIDGE_ENABLED=true

EXPOSE 8200

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8200/health || exit 1

# Run the application
CMD ["./mycelium-runtime", "--port", "8200", "--config", "/app/config/runtime.toml"]